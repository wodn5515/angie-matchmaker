# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# New API keys (recommended). Get these from Supabase Dashboard → Settings → API Keys.
# - Publishable key: starts with `sb_publishable_…` (safe to expose in browser)
# - Secret key:      starts with `sb_secret_…`      (server-only; never commit, never NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Legacy keys (deprecated). The code accepts these as a fallback if the new
# names above are absent, so existing projects keep working. New projects
# should use the publishable/secret pair only.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Operator whitelist
OPERATOR_EMAIL=operator@example.com
OPERATOR_DISPLAY_NAME=운영자이름

# App URL (used to generate share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
